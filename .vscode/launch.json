{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "${defaultBuildTask}",
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "launch STM32F401CD",
      "flashingConfig": {
        "flashingEnabled": true
      },
      "chip": "STM32F401CD",
      "wireProtocol": "Swd",
      "coreConfigs": [
        {
          "programBinary": "target/thumbv7em-none-eabihf/debug/embassy-stm32f401-blinky",
          "rttEnabled": true
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "attach",
      "name": "attach STM32F401CD",
      "cwd": "${workspaceFolder}",
      "chip": "STM32F401CD",
      "wireProtocol": "Swd",
      "coreConfigs": [
        {
          "programBinary": "target/thumbv7em-none-eabihf/debug/embassy-stm32f401-blinky",
          "rttEnabled": true
        }
      ]
    }
  ]
}
